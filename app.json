{
  "expo": {
    "name": "YOL: Kafesten Kemere",
    "slug": "yol-kafesten-kemere",
    "version": "1.1.8",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0e11",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yolmma.game",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.yolmma.game",
      "allowBackup": true,
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0d0e11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./public/icon-192.png",
      "output": "single",
      "name": "YOL: Kafesten Kemere",
      "shortName": "YOL",
      "themeColor": "#0d0e11",
      "backgroundColor": "#0d0e11"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0d0e11"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6387108639379747~8058643285",
          "iosAppId": "ca-app-pub-6387108639379747~8406847821",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "Your data is used to show you more relevant ads. Ads keep the game free; they never give power.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "./plugins/withAdMediation",
      "expo-iap",
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "enforceContrast": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e63946"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Your data is used to show you more relevant ads. Ads keep the game free; they never give power."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Reklam aracılığı adaptörleri sınıf adıyla yüklenir; R8 silmesin\n-keep class com.google.ads.mediation.** { *; }\n-keep class com.unity3d.ads.** { *; }\n-keep class com.unity3d.services.** { *; }\n-keep class com.vungle.** { *; }\n-dontwarn com.vungle.**\n-dontwarn com.unity3d.**\n# RevenueCat ve Firebase\n-keep class com.revenuecat.purchases.** { *; }\n-keep class io.invertase.firebase.** { *; }\n"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "32aeff93-bed4-47e6-ad53-c301ad4f0f07"
      }
    },
    "owner": "yasinozsesliler",
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "pl": "./locales/pl.json"
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-6387108639379747~8058643285",
    "ios_app_id": "ca-app-pub-6387108639379747~8406847821"
  }
}
